{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^(Bash|exec_command|shell_command)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/pre-tool-use.mjs\"",
        "command_windows": "node \"${PLUGIN_ROOT}/scripts/pre-tool-use.mjs\"",
        "timeout": 5,
        "statusMessage": "Compacting command output"
      }]
    }]
  }
}
